{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Functional Requirements Specification",
  "type": "object",
  "required": [
    "context",
    "userStories",
    "functionalRequirements",
    "errorAndEdgeCases",
    "assumptions",
    "openQuestions",
    "traceability",
    "ado"
  ],
  "properties": {
    "context": {
      "type": "string",
      "maxLength": 500
    },
    "userStories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "asA",
          "iWantTo",
          "soThat",
          "storyPoints",
          "priority",
          "tags",
          "acceptanceCriteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-\\d+$"
          },
          "title": {
            "type": "string"
          },
          "asA": {
            "type": "string"
          },
          "iWantTo": {
            "type": "string"
          },
          "soThat": {
            "type": "string"
          },
          "storyPoints": {
            "type": "integer",
            "enum": [1, 2, 3, 5, 8, 13]
          },
          "priority": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relatedUserStories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^US-\\d+$"
            }
          },
          "epic": {
            "type": "string"
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["id", "given", "when", "then"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-\\d+$"
                },
                "given": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                },
                "then": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "functionalRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "inputs",
          "triggers",
          "mainFlow",
          "outputs",
          "relatedUserStories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-\\d+$"
          },
          "description": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mainFlow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relatedUserStories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^US-\\d+$"
            }
          }
        }
      }
    },
    "errorAndEdgeCases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirementId",
          "userStoryId",
          "acceptanceCriteriaIds",
          "notes"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^FR-\\d+$"
          },
          "userStoryId": {
            "type": "string",
            "pattern": "^US-\\d+$"
          },
          "acceptanceCriteriaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-\\d+$"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "ado": {
      "type": "object",
      "required": [
        "epics",
        "features",
        "tasksByUserStory",
        "definitionOfDone",
        "sprintPlanning"
      ],
      "properties": {
        "epics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasksByUserStory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["userStoryId", "tasks"],
            "properties": {
              "userStoryId": {
                "type": "string",
                "pattern": "^US-\\d+$"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "definitionOfDone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sprintPlanning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}