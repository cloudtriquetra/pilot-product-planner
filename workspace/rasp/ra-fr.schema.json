{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ra-fr-schema",
  "title": "Runtime Application Self-Protection (RASP) Functional Requirements",
  "type": "object",
  "required": ["context", "userStories", "errorAndEdgeCases", "assumptions", "openQuestions", "traceability", "ado"],
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief context summary (≤100 words)"
    },
    "userStories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "asA", "iWantTo", "soThat", "storyPoints", "priority", "tags", "acceptanceCriteria"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "asA": {
            "type": "string",
            "minLength": 1
          },
          "iWantTo": {
            "type": "string",
            "minLength": 1
          },
          "soThat": {
            "type": "string",
            "minLength": 1
          },
          "storyPoints": {
            "type": "integer",
            "enum": [1, 2, 3, 5, 8, 13]
          },
          "priority": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relatedUserStories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^US-\\d+$"
            }
          },
          "epic": {
            "type": "string"
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["id", "given", "when", "then"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-\\d+$"
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "errorAndEdgeCases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "userStoryId", "acceptanceCriteriaIds", "notes"],
        "additionalProperties": false,
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^FR-\\d+$"
          },
          "userStoryId": {
            "type": "string",
            "pattern": "^US-\\d+$"
          },
          "acceptanceCriteriaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-\\d+$"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "ado": {
      "type": "object",
      "required": ["epics", "features", "tasksByUserStory", "definitionOfDone", "sprintPlanning"],
      "additionalProperties": false,
      "properties": {
        "epics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasksByUserStory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["userStoryId", "tasks"],
            "additionalProperties": false,
            "properties": {
              "userStoryId": {
                "type": "string",
                "pattern": "^US-\\d+$"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "definitionOfDone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sprintPlanning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}